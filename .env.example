# 复制为 .env 后填写真实值，再执行 docker compose up -d
# 切勿将含真实密码的 .env 提交到仓库
#
# Windows PowerShell:
#   Copy-Item .env.example .env
#   # 然后编辑 .env 中的所有密码/密钥

DB_NAME=bishe
DB_USERNAME=bishe_app
DB_PASSWORD=请填写强数据库密码
MYSQL_ROOT_PASSWORD=请填写不同的root强密码

# Token 签名密钥（请换成随机长字符串）
TOKEN_SECRET=请填写至少32位的高强度随机密钥

# 自动化 API 测试可读验证码明文；正式环境请改为 false
CAPTCHA_EXPOSE_CODE=false

# Redis（Docker 内服务名 redis；本机开发默认 localhost:6379）
REDIS_PASSWORD=请填写Redis强密码
# REDIS_DATABASE=0

# 线上只暴露前端入口；MySQL、Redis、后端仅在 Docker 内网可见
FRONTEND_PORT=80
CORS_ALLOWED_ORIGINS=https://your-domain.example
SWAGGER_ENABLED=false

# 网络授课跨受限网络时配置自己的 TURN 服务
RTC_STUN_URL=stun:stun.l.google.com:19302
RTC_TURN_URL=
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=

# 可选：商家定位识别发货城市，高德 Web 服务 API Key；留空时手动填写城市
AMAP_WEB_KEY=
