# 复制为 .env 后填写真实值，再执行 docker compose up -d
# 切勿将含真实密码的 .env 提交到仓库
#
# Windows PowerShell:
#   Copy-Item .env.example .env
#   # 然后编辑 .env 中的所有密码/密钥

DB_NAME=bishe
DB_USERNAME=bishe_app
DB_PASSWORD=请填写强数据库密码
MYSQL_ROOT_PASSWORD=请填写不同的root强密码

# Token 签名密钥（请换成随机长字符串）
TOKEN_SECRET=请填写至少32位的高强度随机密钥

# 自动化 API 测试可读验证码明文；正式环境请改为 false
CAPTCHA_EXPOSE_CODE=false

# Redis（Docker 内服务名 redis；本机开发默认 localhost:6379）
REDIS_PASSWORD=请填写Redis强密码
# REDIS_DATABASE=0
# Windows 开发启动自动读取本机安装目录；未填写时查找 PATH，再尝试 D:\Redis-123\Redis
# 目录内需有 redis-server.exe 和 redis.conf；配置的端口、密码须与上方一致
# REDIS_DIRECTORY=D:\Redis-123\Redis

# 线上只暴露前端入口；MySQL、Redis、后端仅在 Docker 内网可见
FRONTEND_PORT=80
CORS_ALLOWED_ORIGINS=https://your-domain.example
SWAGGER_ENABLED=false

# 网络授课跨受限网络时配置自己的 TURN 服务
RTC_STUN_URL=stun:stun.l.google.com:19302
RTC_TURN_URL=
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=

# 可选：商家定位识别发货城市，高德 Web 服务 API Key；留空时手动填写城市
AMAP_WEB_KEY=

# 仅在空库首次初始化时设置至少32位的随机密钥。
ADMIN_BOOTSTRAP_SECRET=
# 已有库由部署方填入核实后的初代管理员 ID。
INITIAL_ADMIN_ID=
# 留空时沿用 TOKEN_SECRET。若轮换令牌密钥，请先保留原地图配置加密密钥。
ADMIN_SETTINGS_SECRET=
