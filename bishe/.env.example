# 本地非 Docker 启动后端时，可复制为 .env 或在 IDE 中配置环境变量
# Windows PowerShell 示例:
#   $env:DB_PASSWORD="你的密码"
#   $env:TOKEN_SECRET="随机密钥"
#   .\mvnw.cmd spring-boot:run

DB_HOST=localhost
DB_PORT=3306
DB_NAME=bishe
DB_USERNAME=bishe_app
DB_PASSWORD=请填写本地MySQL密码

# Redis（本机安装：D:\Redis-123\Redis，默认 localhost:6379）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=请填写Redis密码
REDIS_DATABASE=0

TOKEN_SECRET=请修改为至少32位的高强度随机密钥
CORS_ALLOWED_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=false

RTC_STUN_URL=stun:stun.l.google.com:19302
RTC_TURN_URL=
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=
