<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bishe.mapper.HomeworkMapper">

    <resultMap id="HomeworkResultMap" type="com.example.bishe.entity.Homework">
        <id column="homework_id" property="homeworkId"/>
        <result column="course_id" property="courseId"/>
        <result column="publisher_id" property="publisherId"/>
        <result column="deadline" property="deadline"/>
        <result column="hide_result_until_publish" property="hideResultUntilPublish"/>
        <result column="is_result_published" property="isResultPublished"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.bishe.entity.Homework"
            useGeneratedKeys="true" keyProperty="homeworkId">
        INSERT INTO homework (course_id, publisher_id, deadline, hide_result_until_publish, is_result_published)
        VALUES (#{courseId}, #{publisherId}, #{deadline}, #{hideResultUntilPublish}, #{isResultPublished})
    </insert>

    <select id="findById" resultMap="HomeworkResultMap">
        SELECT * FROM homework WHERE homework_id = #{homeworkId}
    </select>

    <select id="findByCourseId" resultMap="HomeworkResultMap">
        SELECT * FROM homework WHERE course_id = #{courseId} ORDER BY homework_id DESC
    </select>

    <select id="findByPublisherId" resultMap="HomeworkResultMap">
        SELECT * FROM homework WHERE publisher_id = #{publisherId} ORDER BY homework_id DESC
    </select>

    <delete id="deleteById">
        DELETE FROM homework WHERE homework_id = #{homeworkId}
    </delete>

    <delete id="deleteByCourseId">
        DELETE FROM homework WHERE course_id = #{courseId}
    </delete>

    <delete id="deleteByPublisherId">
        DELETE FROM homework WHERE publisher_id = #{publisherId}
    </delete>

    <update id="updateResultPublished">
        UPDATE homework SET is_result_published = #{isResultPublished} WHERE homework_id = #{homeworkId}
    </update>

</mapper>
